# Copy this file to .env and fill in your keys. NEVER commit the real .env.
#
# Create keys at: Binance -> API Management
# SECURITY (do all of these):
#   1. Enable ONLY "Enable Reading" and "Enable Spot & Margin Trading".
#   2. NEVER enable withdrawals on this key.
#   3. Restrict the key to your machine's IP address.
#
# For testnet mode, create keys at https://testnet.binance.vision instead.

BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here
