# Copy this file to .env and fill in the credentials for the platform(s)
# you use. NEVER commit the real .env.

# ---- Binance (crypto) -------------------------------------------------
# Create keys at: Binance -> API Management
# SECURITY (do all of these):
#   1. Enable ONLY "Enable Reading" and "Enable Spot & Margin Trading".
#   2. NEVER enable withdrawals on this key.
#   3. Restrict the key to your machine's IP address.
# For testnet mode, create keys at https://testnet.binance.vision instead.

BINANCE_API_KEY=your_key_here
BINANCE_API_SECRET=your_secret_here

# ---- OANDA (forex) ----------------------------------------------------
# Free practice account: https://www.oanda.com -> demo account,
# then "Manage API Access" to generate a token. The account ID looks
# like 101-004-1234567-001. A token is needed even for paper mode
# (OANDA market data requires authentication).

OANDA_API_TOKEN=your_token_here
OANDA_ACCOUNT_ID=your_account_id_here
