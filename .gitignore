# Local clone of the community NotebookLM MCP server (installed by
# scripts/setup-notebooklm-mcp.sh) — contains auth state, never commit it.
tools/notebooklm-mcp/

# Scraped site corpora are regenerated with scripts/scrape_site.py, so they
# stay out of git — except the zagzoog.com archive, which cannot be re-fetched
# from every environment and is the point of the exercise.
data/*
!data/zagzoog/
