# Copy to .env and fill in. Never commit the real .env.
# Get your key from the Vital dashboard: https://app.tryvital.io

VITAL_API_KEY=sk_...              # required (secret — server only)
VITAL_ENV=sandbox                 # sandbox | production
VITAL_REGION=us                   # us | eu
PORT=8787
ALLOWED_ORIGIN=*                  # e.g. https://yaserzagzoog.github.io
